# pnpm 严格模式：禁止幽灵依赖
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# Electron 镜像（国内加速；2026-09-20 Electron 43 升级实测 github.com 直连
# 下载失败（fetch failed），启用镜像后成功——保持启用以保证新环境可安装）
electron_mirror=https://npmmirror.com/mirrors/electron/
# better-sqlite3 镜像（v13 起为包内 N-API 预编译产物，无需下载；保留备用）
# better_sqlite3_binary_host_mirror=https://npmmirror.com/mirrors/better-sqlite3
