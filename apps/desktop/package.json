{
  "name": "@urchin/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Urchin Browser 主 Electron 应用",
  "author": "Urchin Browser Contributors",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "wait-on ./dist/main/index.js && electron .",
    "start": "node scripts/launch.mjs",
    "build": "tsc -b && pnpm run build:renderer && pnpm run build:main && pnpm run build:preload",
    "build:main": "vite build --mode main",
    "build:preload": "vite build --mode preload",
    "build:renderer": "vite build --mode renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "package:win": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer && node ../../scripts/genoffice-build.mjs && node ../../scripts/fetch-node.mjs && node ../../scripts/clean-release.mjs && node ../../scripts/package-win.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@radix-ui/react-slot": "^1.3.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "imapflow": "^1.0.182",
    "lucide-react": "^1.27.0",
    "marked": "18.0.5",
    "nodemailer": "^6.10.1",
    "pi-web-ui": "0.97.0",
    "postal-mime": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@urchin/ai-extension": "workspace:*",
    "@urchin/ai-provider-contract": "workspace:*",
    "@urchin/browser-host": "workspace:*",
    "@urchin/chrome-types": "workspace:*",
    "@urchin/ipc-contract": "workspace:*",
    "@urchin/logger": "workspace:*",
    "@urchin/provider-sdk": "workspace:*",
    "@urchin/summary-agent": "workspace:*",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "^10.5.4",
    "electron": "^43.7.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.24",
    "tailwindcss": "3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.0"
  }
}
