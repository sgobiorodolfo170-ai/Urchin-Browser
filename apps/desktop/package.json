{
  "name": "@urchin/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Urchin Browser 主 Electron 应用",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "wait-on ./dist/main/index.js && electron .",
    "build": "tsc -b && vite build",
    "build:main": "vite build --mode main",
    "build:preload": "vite build --mode preload",
    "build:renderer": "vite build --mode renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "package:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "@urchin/chrome-types": "workspace:*",
    "@urchin/ipc-contract": "workspace:*",
    "@urchin/logger": "workspace:*",
    "better-sqlite3": "^11.3.0",
    "electron": "^32.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xstate": "^5.18.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron-builder": "^25.0.0",
    "jsdom": "^30.0.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.0"
  }
}
