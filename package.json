{
  "name": "urchin-browser",
  "version": "0.1.0",
  "private": true,
  "description": "AI 原生 + 开发者友好的桌面浏览器，基于 Electron / 完整 Chromium 内核",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Urchin Browser Contributors",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "packageExtensions": {
      "pi-web-ui": {
        "dependencies": {
          "@earendil-works/pi-tui": "1.4.0"
        }
      }
    },
    "overrides": {
      "@earendil-works/pi-durable": "workspace:*",
      "pi-web-ui>@earendil-works/pi-coding-agent": "1.4.0",
      "@earendil-works/chord@^1.0.0": "1.4.0",
      "@earendil-works/pi-agent-core@^1.0.0": "1.4.0",
      "@earendil-works/pi-ai@^1.0.0": "1.4.0",
      "@earendil-works/pi-codemode@^1.0.0": "1.4.0",
      "@earendil-works/pi-coding-agent@^1.0.0": "1.4.0",
      "@earendil-works/pi-mcp@^1.0.0": "1.4.0",
      "@earendil-works/pi-telemetry@^1.0.0": "1.4.0",
      "@earendil-works/pi-tui@^1.0.0": "1.4.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @urchin/desktop dev",
    "start": "pnpm --filter @urchin/desktop start",
    "build": "pnpm --filter @urchin/desktop build",
    "typecheck": "pnpm -r --filter \"@urchin/*\" typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage && pnpm check:docs && node scripts/mark-verify-ok.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter \"@urchin/*\" test",
    "test:coverage": "pnpm -r --filter \"@urchin/*\" test -- --coverage",
    "check:docs": "node scripts/check-doc-drift.mjs",
    "e2e": "pnpm --filter @urchin/desktop e2e",
    "genoffice:build": "node scripts/genoffice-build.mjs",
    "package:win": "pnpm --filter @urchin/desktop package:win",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "get-east-asian-width": "1.6.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "marked": "18.0.11",
    "marked-cjk-friendly": "0.1.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
