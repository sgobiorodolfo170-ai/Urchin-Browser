{
  "version": 2,
  "locale": "zh-CN",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    "vendor",
    "dist",
    "build",
    "target",
    ".next",
    "coverage",
    "tmp",
    "uploads",
    "backup",
    "backups",
    "artifacts",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage"
  ],
  "exclude_exts": [],
  "curation_exclude": [],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 8000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "production",
    "observe_change_policy": "review_required",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
      {
        "rule_id": "exclude-apps-pi-web",
        "action": "exclude",
        "pattern": "apps/pi-web",
        "pattern_kind": "directory",
        "reason": "pi-web-ui上游前端/服务全量移植(第三方派生),无逐文件可维护语义;Urchin集成代码在main/pi-web-host与packages/pi-web-host;维护者指令排除",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "maintainer",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-ico-raster-assets",
        "action": "exclude",
        "pattern": "apps/desktop/ico/icon-*.png",
        "pattern_kind": "glob",
        "reason": "品牌图标源文件(二进制构建资产),无逐文件可维护语义,由build-ico.cjs消费;维护者指令排除",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "maintainer",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-ico-source-jpg",
        "action": "exclude",
        "pattern": "apps/desktop/ico/61c359892bac24a7500ece0e10a807e6.jpg",
        "pattern_kind": "file",
        "reason": "图标处理源图(JPG,二进制),由process-icon.ps1消费;维护者指令排除",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "maintainer",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-renderer-root-png",
        "action": "exclude",
        "pattern": "apps/desktop/src/renderer/public/*.png",
        "pattern_kind": "glob",
        "reason": "渲染器品牌图标(二进制资产),无独立可维护语义;维护者指令排除",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "maintainer",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "exclude-site-favicons",
        "action": "exclude",
        "pattern": "apps/desktop/src/renderer/public/sites",
        "pattern_kind": "directory",
        "reason": "952个站点favicon(新标签页数据资产,由fetch-site-icons.mjs生成),逐文件语义无意义;维护者指令排除",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "maintainer",
        "order": 0,
        "enabled": true
      }
    ]
  },
  "cognition_budget": {
    "version": "cognition-budget-policy/v1",
    "mode": "enforce",
    "whole_index": {
      "target_tokens": 200000,
      "warning_tokens": 300000,
      "max_tokens": 400000
    },
    "r": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 25,
        "max_tokens": 50
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 45,
        "max_tokens": 90
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 90,
        "max_tokens": 180
      }
    ],
    "s": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 20,
        "max_tokens": 40
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 40,
        "max_tokens": 80
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 100,
        "max_tokens": 200
      }
    ]
  },
  "installed_agents": [
    "opencode"
  ],
  "automation": {
    "mode": "auto"
  },
  "ai": {
    "enabled": false,
    "provider": "openai-compatible",
    "base_url": "",
    "model": "",
    "api_key_env": "",
    "timeout_seconds": 0,
    "max_concurrency": 0,
    "max_input_tokens": 0,
    "token_accounting": "auto",
    "prompt_snapshot": "redacted"
  }
}
