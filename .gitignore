# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
out/
*.tsbuildinfo

# Electron 打包
release/
release-v*/
apps/desktop/release-v*/
*.exe
*.app
*.deb
*.snap
*.dmg
*.asar

# 测试与覆盖率
coverage/
.nyc_output/
test-results/
playwright-report/

# 编辑器
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志与本地数据
*.log
# 只忽略仓库根的 logs/，不要用无锚定的 `logs/`：它会吞掉同名源码目录
# （2026-11-09 实测：apps/desktop/src/main/logs/ 的 3 个源文件 + 2 个测试因此从未入库，
#  本地 typecheck 绿、CI 干净 clone 直接 TS2307）。门禁见 scripts/check-src-tracked.mjs（G18）
/logs/
.env
.env.local
.env.*.local

# Vite
.vite/

# Electron
electron-builder.lock

# 临时脚本
.tmp-*.ps1
.tmp-*

# 本地调试残留（一次性脚本 / 测试产物 / 运行数据）
.electron-cache/
.test-user-data/
temp-test/
test-output/
tmp/

# 本地运行数据（书签/历史/设置/cookies/下载等，不入库）
apps/desktop/data/

# AI 工具状态（Mimosa / ZCode 会话与报告，非项目产物）
.mimosa/
.zcode/

# 本地辅助脚本（开发便利工具，不随项目分发）
build-and-run.cmd
build-and-run.bat
apps/desktop/build-and-run.bat
powershell.bat
powershell.cmd
apps/desktop/powershell.bat
apps/desktop/powershell.cmd

