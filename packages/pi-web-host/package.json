{
  "name": "@urchin/pi-web-host",
  "version": "0.2.0",
  "private": true,
  "description": "pi 阶段 2 托管服务：utilityProcess 内 HTTP 静态 + WebSocket + 随机 token 鉴权；业务层并入上游 pi-web-ui server 的 pi 引擎子集",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./shared/*": "./src/pi-server/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0",
    "tar": "^7.5.22",
    "typebox": "^1.3.34",
    "undici": "^8.9.0",
    "ws": "8.22.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "8.18.2",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
