        /* page-index.css 已经不能发布，在迁移之前先快速覆盖样式 */
        .login-inner {
            width: 400px !important;
        }
        .wy-login-wrapper.v3 .pact-wrapper {
            position: static;
            padding: 0;
            width: 100px;
            background: #fff;
            text-align: center;
            transform: translateX(0);
        }
        .wy-login-wrapper.v3 .login-agreement {
            position: static;
            -webkit-transform: translateX(0);
            transform: translateX(0);
            font-size: 12px;
        }
        .wy-login-wrapper.v3 {
            height: 100%;
            width: 100%;
        }
        .wy-login-wrapper.v3 .service-protocol {
            display: flex;
            justify-content: space-evenly;
            position: relative;
            margin: 10px auto;
            background-color: white;
        }
        .wy-login-wrapper.v3  .icon-checkbox-xs{
            display: inline-block;
            width: 16px;
            height: 16px;
            background-image: url(https://qzonestyle.gtimg.cn/qz-proj/wy-pc-v3/static/img/svg/icon-checkbox-xs.svg);
            margin: 0 4px 0 0;
            top: -1px;
            cursor: pointer;
        }
        .wy-login-wrapper.v3 .mask {
            height: 250px;
        }
        .wy-login-wrapper.v3 .act .icon-checkbox-xs{
            background-image: url(https://qzonestyle.gtimg.cn/qz-proj/wy-pc-v3/static/img/svg/icon-checkbox-xs-act.svg);
        }
        .wy-login-wrapper.v3 .pact-wrapper .mod-check .txt {
            margin: 0;
        }
        .wy-login-wrapper.v3 .login {
            height: 250px;
            margin: 100px 0 10px 0;
        }
    </style>
